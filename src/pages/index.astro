---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../data/site';

const sections = [
  {
    href: '/blogs',
    title: 'Blogs',
    desc: 'Notes and essays — half software, half whatever I was reading that week.',
  },
  {
    href: '/bookshelf',
    title: 'Bookshelf',
    desc: 'A running list of what I’m reading and have read.',
  },
  {
    href: '/work',
    title: 'Work',
    desc: 'Where I’ve worked and what I’ve built.',
  },
  {
    href: '/links',
    title: 'Links',
    desc: 'Essays, posts, and videos worth your time.',
  },
];
---

<BaseLayout title={SITE.name}>
  <section class="hero wrap">
    <img
      class="hero-bg"
      src="/images/hero-field.png"
      alt=""
      aria-hidden="true"
      width="1600"
      height="1000"
    />
    <p class="label">Kochi, Kerala</p>
    <h1 class="name">Anandu<br />Ramachandran</h1>
    <ul class="tags" aria-label="What I do">
      {SITE.tags.map((tag) => <li>{tag}</li>)}
    </ul>
    <p class="intro">
      I write software for a living, collect words the way some people collect
      records, and keep a running, mostly-losing argument with philosophy
      about how any of us should live. This is where those three things share
      a roof.
    </p>
  </section>

  <section class="wrap index-grid" aria-label="Sections">
    {
      sections.map((s) => (
        <a class="index-card plain" href={s.href}>
          <span class="index-card-head">
            <span class="index-title">{s.title}</span>
            <span class="index-arrow" aria-hidden="true">&rarr;</span>
          </span>
          <span class="index-desc">{s.desc}</span>
        </a>
      ))
    }
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    padding-block: var(--space-8) var(--space-7);
    overflow: clip;
  }

  .hero-bg {
    position: absolute;
    inset: -10% -5% auto -5%;
    width: 110%;
    height: auto;
    opacity: 0.5;
    pointer-events: none;
    z-index: -1;
    mask-image: linear-gradient(to bottom, black 0%, black 55%, transparent 100%);
  }

  .name {
    font-size: clamp(2.75rem, 8vw, 5.5rem);
    margin: var(--space-2) 0 var(--space-4);
    letter-spacing: -0.01em;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    list-style: none;
    margin: 0 0 var(--space-5);
    padding: 0;
  }

  .tags li {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-fg);
    padding: 0.35rem 0.75rem;
    border: 1px solid var(--color-border-strong);
    border-radius: 999px;
  }

  .tags li:nth-child(2) {
    color: var(--color-accent);
    border-color: color-mix(in srgb, var(--color-accent) 55%, var(--color-border-strong));
  }

  .intro {
    font-size: 1.2rem;
    line-height: 1.7;
    color: var(--color-fg-muted);
    max-width: 42ch;
  }

  .index-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--color-border);
    border: 1px solid var(--color-border);
    margin-bottom: var(--space-8);
  }

  .index-card {
    background: var(--color-bg);
    padding: var(--space-5);
    text-decoration: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    transition: background var(--duration-med) var(--ease-out);
  }

  .index-card:hover {
    background: var(--color-surface);
  }

  .index-card-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
  }

  .index-title {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 600;
    color: var(--color-fg);
  }

  .index-arrow {
    font-family: var(--font-mono);
    color: var(--color-accent);
    transition: transform var(--duration-med) var(--ease-out);
  }

  .index-card:hover .index-arrow {
    transform: translateX(4px);
  }

  .index-desc {
    color: var(--color-fg-muted);
    font-size: 0.95rem;
    max-width: 32ch;
  }

  @media (max-width: 640px) {
    .index-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
