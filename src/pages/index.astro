---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../data/site';
---

<BaseLayout title={SITE.name}>
  <div class="page-bg" aria-hidden="true"></div>

  <section class="hero wrap">
    <p class="label">Kochi, Kerala</p>
    <h1 class="name">Anandu Ramachandran</h1>
    <p class="subtitle">{SITE.tags.join(' · ')}</p>

    <p class="statement">
      Somewhere between writing software and reading{' '}
      <em>too much philosophy</em>, mostly chasing good words in between.
    </p>

    <p class="intro">
      I write software for a living, collect words the way some people
      collect records, and keep a running, mostly-losing argument with
      philosophy about how any of us should live. This is where those three
      things share a roof.
    </p>
  </section>
</BaseLayout>

<style>
  .page-bg {
    position: fixed;
    inset: 0;
    z-index: -1;
    background: url('/images/hero-field.png') center 15% / cover no-repeat;
    opacity: 0.2;
    pointer-events: none;
  }

  .hero {
    position: relative;
    padding-block: var(--space-8);
  }

  .name {
    font-size: clamp(2.5rem, 6.5vw, 4rem);
    margin: var(--space-2) 0 var(--space-2);
    letter-spacing: -0.005em;
    max-width: 18ch;
  }

  .subtitle {
    font-size: 1.15rem;
    font-style: italic;
    color: var(--color-fg-muted);
    margin: 0 0 var(--space-6);
  }

  .statement {
    font-size: clamp(1.6rem, 3.4vw, 2.4rem);
    line-height: 1.35;
    margin: 0 0 var(--space-5);
    max-width: 26ch;
    text-wrap: balance;
  }

  .intro {
    font-size: 1.08rem;
    line-height: 1.7;
    color: var(--color-fg-muted);
    max-width: 46ch;
  }
</style>
