---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const dateFmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<BaseLayout title="Blogs" description="Notes and essays on software and whatever else.">
  <section class="wrap page-head">
    <p class="label">Writing</p>
    <h1>Blogs</h1>
    <p class="prose page-desc">
      Half software, half whatever I was reading that week. New posts land
      here as they're written.
    </p>
  </section>

  <section class="wrap post-list">
    {
      posts.length === 0 ? (
        <p class="empty">Nothing published yet — first post is on its way.</p>
      ) : (
        <>
          <div class="search-row">
            <input
              type="text"
              id="blog-search"
              class="search-input"
              placeholder="Search posts…"
              aria-label="Search posts"
            />
            <p class="label post-count" id="blog-count">
              Showing {posts.length} of {posts.length} posts
            </p>
          </div>
          <div id="blog-post-rows">
            {posts.map((post) => (
              <a
                class="post-row plain"
                href={`/blogs/${post.id}`}
                data-title={post.data.title.toLowerCase()}
              >
                <span class="post-body">
                  <span class="post-title">{post.data.title}</span>
                  <span class="post-desc">{post.data.description}</span>
                </span>
                <span class="post-date label">{dateFmt(post.data.date)}</span>
              </a>
            ))}
          </div>
        </>
      )
    }
  </section>
</BaseLayout>

<script>
  const input = document.getElementById('blog-search');
  const rows = document.querySelectorAll('#blog-post-rows .post-row');
  const count = document.getElementById('blog-count');
  const total = rows.length;

  input?.addEventListener('input', () => {
    const q = input.value.trim().toLowerCase();
    let visible = 0;
    rows.forEach((row) => {
      const match = (row.getAttribute('data-title') ?? '').includes(q);
      row.style.display = match ? '' : 'none';
      if (match) visible += 1;
    });
    if (count) count.textContent = `Showing ${visible} of ${total} posts`;
  });
</script>

<style>
  .page-head {
    padding-top: var(--space-7);
  }

  .page-desc {
    color: var(--color-fg-muted);
  }

  .post-list {
    padding-bottom: var(--space-5);
  }

  .search-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-2);
  }

  .search-input {
    flex: 1 1 16rem;
    max-width: 20rem;
    padding: 0.5rem 0.9rem;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-fg);
    font-family: var(--font-serif);
    font-size: 0.92rem;
  }

  .search-input::placeholder {
    color: var(--color-fg-faint);
  }

  .post-count {
    white-space: nowrap;
  }

  .post-row {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: start;
    gap: var(--space-4);
    padding-block: var(--space-4);
    border-top: 1px solid var(--color-border);
    text-decoration: none;
  }

  .post-list a:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  .post-date {
    padding-top: 0.2rem;
    color: var(--color-fg-faint);
    white-space: nowrap;
  }

  .post-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .post-title {
    font-family: var(--font-serif);
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--color-fg);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .post-row:hover .post-title {
    color: var(--color-accent);
    font-style: italic;
  }

  .post-desc {
    color: var(--color-fg-muted);
    max-width: 60ch;
  }

  .empty {
    color: var(--color-fg-muted);
    padding-block: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  @media (max-width: 560px) {
    .post-row {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }
  }
</style>
