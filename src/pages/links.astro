---
import BaseLayout from '../layouts/BaseLayout.astro';
import { linkSections } from '../data/links';
---

<BaseLayout title="Links" description="Essays, posts, and videos worth your time.">
  <section class="wrap page-head">
    <p class="label">Elsewhere</p>
    <h1>Links</h1>
    <p class="prose page-desc">Things I've written, watched, or want to point at.</p>
  </section>

  <section class="wrap sections">
    {
      linkSections.map((section) => (
        <div class="link-section">
          <h2 class="label section-title">{section.title}</h2>
          <ul class="link-list">
            {section.items.map((item) => (
              <li>
                <a href={item.href} target={item.href.startsWith('http') ? '_blank' : undefined} rel="noopener noreferrer">
                  {item.text}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </section>
</BaseLayout>

<style>
  .page-head {
    padding-top: var(--space-7);
  }

  .page-desc {
    color: var(--color-fg-muted);
  }

  .sections {
    padding-bottom: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .section-title {
    margin-bottom: var(--space-3);
  }

  .link-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .link-list li {
    border-top: 1px solid var(--color-border);
  }

  .link-list li:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  .link-list a {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding-block: var(--space-3);
    text-decoration: none;
    color: var(--color-fg);
    transition: color var(--duration-fast) var(--ease-out), padding-left var(--duration-med) var(--ease-out);
  }

  .link-list a::before {
    content: '\2192';
    color: var(--color-accent);
    font-family: var(--font-mono);
    opacity: 0;
    transition: opacity var(--duration-fast) var(--ease-out);
  }

  .link-list a:hover {
    color: var(--color-accent);
    padding-left: var(--space-1);
  }

  .link-list a:hover::before {
    opacity: 1;
  }
</style>
