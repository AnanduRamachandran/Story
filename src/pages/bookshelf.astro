---
import BaseLayout from '../layouts/BaseLayout.astro';
import { books } from '../data/bookshelf';
---

<BaseLayout title="Bookshelf" description="A running list of what I'm reading and have read.">
  <section class="wrap page-head">
    <p class="label">Reading</p>
    <h1>Bookshelf</h1>
    <blockquote class="quote">
      “One glance at a book and you hear the voice of another person,
      perhaps someone dead for 1,000 years.{' '}
      <span class="accent">To read is to voyage through time.</span>”
      <cite>— Carl Sagan</cite>
    </blockquote>
    <p class="prose page-desc">
      A plain list, not a review site. I add to it as I go — no ratings, no
      pretense of finishing everything I start. A hollow dot marks what I'm
      still reading.
    </p>
  </section>

  <section class="wrap shelves">
    {
      books.length > 0 ? (
        <ul class="book-list">
          {books.map((b) => (
            <li>
              <span class={`dot ${b.status === 'reading' ? 'dot-reading' : ''}`} aria-hidden="true" />
              <span class="book-content">
                <span class="book-title">{b.title}</span>
                <span class="book-author">{b.author}</span>
                {b.note && <span class="book-note">{b.note}</span>}
              </span>
            </li>
          ))}
        </ul>
      ) : (
        <p class="empty">Nothing on the shelf yet.</p>
      )
    }
  </section>
</BaseLayout>

<style>
  .page-head {
    padding-top: var(--space-7);
  }

  .quote {
    margin: var(--space-4) 0;
    padding: 0;
    border: none;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(1.25rem, 2.6vw, 1.7rem);
    line-height: 1.45;
    color: var(--color-fg);
    max-width: 46ch;
  }

  .quote cite {
    display: block;
    margin-top: var(--space-2);
    font-style: normal;
    font-size: 0.85rem;
    color: var(--color-fg-faint);
  }

  .quote .accent {
    color: var(--color-accent);
  }

  .page-desc {
    color: var(--color-fg-muted);
  }

  .shelves {
    padding-bottom: var(--space-5);
  }

  .book-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-border);
  }

  .book-list li {
    display: grid;
    grid-template-columns: 12px 1fr;
    column-gap: 0.55em;
    padding-block: 0.55rem;
    border-bottom: 1px solid var(--color-border);
  }

  .dot {
    box-sizing: border-box;
    width: 5px;
    height: 5px;
    margin-top: 0.55em;
    border-radius: 50%;
    background: var(--color-fg-faint);
    justify-self: center;
  }

  .book-content {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.1em 0.5em;
    font-size: 0.88rem;
  }

  .dot-reading {
    background: transparent;
    border: 1px solid var(--color-fg-faint);
  }

  .book-title {
    font-family: var(--font-serif);
    font-weight: 700;
    color: var(--color-fg);
  }

  .book-author {
    color: var(--color-fg-muted);
    font-style: italic;
  }

  .book-author::before {
    content: '— ';
  }

  .book-note {
    font-style: italic;
    font-size: 0.75rem;
    color: var(--color-fg-faint);
    width: 100%;
  }

  .empty {
    color: var(--color-fg-muted);
  }
</style>
