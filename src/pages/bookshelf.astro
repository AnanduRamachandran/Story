---
import BaseLayout from '../layouts/BaseLayout.astro';
import { books } from '../data/bookshelf';

const reading = books.filter((b) => b.status === 'reading');
const read = books.filter((b) => b.status === 'read');
---

<BaseLayout title="Bookshelf" description="A running list of what I'm reading and have read.">
  <section class="wrap page-head">
    <p class="label">Reading</p>
    <h1>Bookshelf</h1>
    <p class="prose page-desc">
      A plain list, not a review site. I add to it as I go — no ratings, no
      pretense of finishing everything I start.
    </p>
  </section>

  <section class="wrap shelves">
    {
      reading.length > 0 && (
        <div class="shelf">
          <h2 class="label shelf-title">Currently reading</h2>
          <ul class="book-list">
            {reading.map((b) => (
              <li>
                <span class="dot dot-reading" aria-hidden="true" />
                <span class="book-title">{b.title}</span>
                <span class="book-author">{b.author}</span>
                {b.note && <span class="book-note">{b.note}</span>}
              </li>
            ))}
          </ul>
        </div>
      )
    }

    {
      read.length > 0 && (
        <div class="shelf">
          <h2 class="label shelf-title">Read</h2>
          <ul class="book-list">
            {read.map((b) => (
              <li>
                <span class="dot" aria-hidden="true" />
                <span class="book-title">{b.title}</span>
                <span class="book-author">{b.author}</span>
                {b.note && <span class="book-note">{b.note}</span>}
              </li>
            ))}
          </ul>
        </div>
      )
    }

    {books.length === 0 && <p class="empty">Nothing on the shelf yet.</p>}
  </section>
</BaseLayout>

<style>
  .page-head {
    padding-top: var(--space-7);
  }

  .page-desc {
    color: var(--color-fg-muted);
  }

  .shelves {
    padding-bottom: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .shelf-title {
    margin-bottom: var(--space-3);
  }

  .book-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-border);
  }

  .book-list li {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.15em 0.6em;
    padding-block: var(--space-2);
    border-bottom: 1px solid var(--color-border);
  }

  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-fg-faint);
    align-self: center;
    flex-shrink: 0;
  }

  .dot-reading {
    background: var(--color-accent);
    box-shadow: 0 0 6px color-mix(in srgb, var(--color-accent) 70%, transparent);
  }

  .book-title {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--color-fg);
  }

  .book-author {
    color: var(--color-fg-muted);
    font-style: italic;
  }

  .book-author::before {
    content: '— ';
  }

  .book-note {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-fg-faint);
    width: 100%;
    padding-left: 1.15em;
  }

  .empty {
    color: var(--color-fg-muted);
  }
</style>
