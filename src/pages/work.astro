---
import BaseLayout from '../layouts/BaseLayout.astro';
import { experience } from '../data/work';
---

<BaseLayout title="Work" description="Where I've worked and what I've built.">
  <section class="wrap page-head">
    <p class="label">Career</p>
    <h1>Work</h1>
  </section>

  <section class="wrap block">
    {
      experience.map((entry) => (
        <div class="org">
          <div class="org-head">
            <h2>{entry.org}</h2>
            <span class="label">{entry.location}</span>
          </div>
          <div class="roles">
            {entry.roles.map((role) => (
              <div class="role">
                <div class="role-head">
                  <h3>{role.title}</h3>
                  <span class="label role-period">{role.period}</span>
                </div>
                <p class="role-summary">{role.summary}</p>
              </div>
            ))}
          </div>
        </div>
      ))
    }
  </section>
</BaseLayout>

<style>
  .page-head {
    padding-top: var(--space-7);
  }

  .block {
    padding-block: var(--space-5) var(--space-8);
  }

  .org + .org {
    margin-top: var(--space-6);
  }

  .org-head {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .org-head h2 {
    margin: 0;
  }

  .role + .role {
    margin-top: var(--space-5);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
  }

  .role-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
  }

  .role-head h3 {
    margin: 0;
    font-size: 1.1rem;
  }

  .role-summary {
    margin: 0;
    color: var(--color-fg-muted);
    max-width: 60ch;
  }
</style>
